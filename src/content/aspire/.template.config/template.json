      "manualInstructions": [
        {
          "text": "Run 'dotnet add tools/Project1.ServiceDefaults/Project1.ServiceDefaults.csproj package Microsoft.Extensions.Http.Resilience --version 10.11.0' from the solution root."
        }
      ],
      "applyFileRenamesToManualInstructions": true,
